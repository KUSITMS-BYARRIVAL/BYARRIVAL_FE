# .env로 복사해 값을 채운다. EXPO_PUBLIC_ 값은 앱 번들에 그대로 들어가므로 공개돼도 되는 값만 둔다

# API 서버 호스트 (/api/v1 제외)
EXPO_PUBLIC_API_BASE_URL=

# PostHog > Project settings > Project token (공개 키). 로컬은 dev 프로젝트 키, 비워 두면 이벤트를 보내지 않는다
EXPO_PUBLIC_POSTHOG_KEY=

# 카카오 디벨로퍼스 > 앱 키 > 네이티브 앱 키. 비워 두면 카카오 로그인 플러그인 없이 빌드된다
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
